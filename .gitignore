.DS_Store
node_modules/
.vite/
dist/
dist-demo/
dist-pages-demo/
dist-pages-presentation/
.pages/
.env
.env.*
!.env.example
*.local

# Local backup archives may contain service credentials.
backups/

# Generated at build time from @mdi/svg
app/public/mdi-icons/

# Paraglide: generated at build time (npm run paraglide:compile)
app/src/paraglide/

# Phone hero derivations: generated at build time (npm run hero:phone)
app/public/hero/*-phone.avif

# Automatic household migration rollback copies
app/config/households/*.backup-v*-*

# Astro: generated types of the wiki (docs-site)
.astro/

# Android release builds; signing material is always kept outside source.
android/build/
android/.deps/
*.keystore
*.jks
# Also ignore locally reused dependency-directory symlinks.
app/node_modules
docs-site/node_modules
