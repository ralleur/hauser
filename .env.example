# Public beta defaults. Copy to .env before changing values.
HAUSER_IMAGE_REPOSITORY=ghcr.io/ralleur/hauser
HAUSER_IMAGE_TAG=v0.4.0-beta.1
HAUSER_BIND_ADDRESS=127.0.0.1
HAUSER_PORT=4173

# Add every browser origin that may operate Hauser. If you expose the service on
# your LAN, replace the examples with the exact http(s) origin(s) you use.
HMI_ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
